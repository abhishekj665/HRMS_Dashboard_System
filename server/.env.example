# Server
PORT=5000
SECRET=replace_with_a_secure_app_secret
JWT_PASSWORD=replace_with_a_secure_jwt_secret

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hrms_dashboard
DB_USER=root
DB_PASSWORD=replace_with_your_database_password

# Email
MAIL_USER=your_email@example.com
MAIL_PASS=replace_with_your_email_password
BREVO_API_KEY=your_brevo_api_key

# External services
GEO_API_KEY=your_geo_api_key
CLOUD_NAME=your_cloudinary_name
CLOUD_KEY=your_cloudinary_key
CLOUD_SECRET=your_cloudinary_secret

# Application URLs
CLIENT_URL=http://localhost:5173
OFFER_URL=http://localhost:5173/offer
DOMAIN_URL=http://localhost:5173
CUSTOM_DOMAIN=

# Razorpay (optional unless payment features are used)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
